# Build only the isolated context generated by prepare.ps1.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json NuGet.Config ./
COPY src/Els.ReadinessProbe/Els.ReadinessProbe.csproj src/Els.ReadinessProbe/
RUN dotnet restore src/Els.ReadinessProbe/Els.ReadinessProbe.csproj --configfile NuGet.Config
COPY src/Els.ReadinessProbe/ src/Els.ReadinessProbe/
RUN dotnet publish src/Els.ReadinessProbe/Els.ReadinessProbe.csproj \
    --configuration Release --no-restore --no-self-contained \
    --output /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /out/ ./
USER $APP_UID
EXPOSE 5080
ENTRYPOINT ["dotnet", "Els.ReadinessProbe.dll"]
# Override appsettings.json's localhost-only binding for Pod-IP access.
CMD ["--urls", "http://0.0.0.0:5080"]
